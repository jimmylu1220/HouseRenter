TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
POSTGRES_USER=jimmylu
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=houserenter

# ── Facebook 租屋社團爬蟲（選填）─────────────────────────────────────────────
# 留空 FACEBOOK_GROUPS 即停用 FB 爬蟲，591/HouseFun 不受影響。
#
# FACEBOOK_GROUPS：逗號分隔的 group id（純數字）或 vanity slug，例如：
#   FACEBOOK_GROUPS=123456789012345,taipei.rent.house
# FACEBOOK_COOKIES_PATH：Playwright storage_state JSON 路徑（從已登入瀏覽器匯出）
#   產生方式：playwright codegen --save-storage=fb_state.json https://m.facebook.com
# FACEBOOK_MAX_POSTS_PER_GROUP：每組社團單次最多抓幾篇貼文（預設 30）
FACEBOOK_GROUPS=
FACEBOOK_COOKIES_PATH=
FACEBOOK_MAX_POSTS_PER_GROUP=30
