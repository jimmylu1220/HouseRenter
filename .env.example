TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
POSTGRES_USER=jimmylu
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=houserenter

# ── Facebook 租屋社團爬蟲（選填）─────────────────────────────────────────────
# 留空 FACEBOOK_GROUPS 即停用 FB 爬蟲，591 不受影響。
#
# FACEBOOK_GROUPS：逗號分隔的社團 id（純數字）或 vanity slug，例如：
#   FACEBOOK_GROUPS=123456789012345,taipei.rent.house
# 登入狀態：在本機執行 python scripts/fb_login.py 產生 secrets/fb_state.json，
#   再複製到伺服器的 ./secrets/ 目錄（docker 內路徑為 /secrets/fb_state.json）。
# FACEBOOK_MAX_POSTS_PER_GROUP：每個社團每輪最多抓幾篇（預設 30）
# FACEBOOK_INTERVAL_MINUTES：FB 排程間隔分鐘（預設 15，太頻繁容易被封）
# FACEBOOK_ADMIN_CHAT_ID：登入失效時要通知的 Telegram chat id
FACEBOOK_GROUPS=
FACEBOOK_MAX_POSTS_PER_GROUP=30
FACEBOOK_INTERVAL_MINUTES=15
FACEBOOK_ADMIN_CHAT_ID=

# ── Discord 頻道通知（選填）──────────────────────────────────────────────────
# DISCORD_WEBHOOK_URL：頻道設定 → 整合 → Webhook → 複製網址；留空即停用。
# DISCORD_MIRROR_CHAT_ID：Discord 頻道會同步這位 Telegram 使用者收到的新房源
#   （套用他的篩選條件與黑名單；他必須是「開始」監控中的狀態）。
#   查自己的 chat id：對 bot 輸入 /status，回覆裡的 Chat ID 就是。
# 測試：python scripts/discord_test.py
DISCORD_WEBHOOK_URL=
DISCORD_MIRROR_CHAT_ID=

# ── Discord bot（選填）──────────────────────────────────────────────────────
# 每個 Discord 頻道可以有自己的推播條件，直接在頻道裡用 slash 指令設定：
#   /subscribe 開始推播、/filters 設定條件、/status 查看、/unsubscribe 停止
# 建立方式：https://discord.com/developers/applications → New Application
#   → Bot → Reset Token 複製 token；
#   → OAuth2 → URL Generator 勾 bot + applications.commands，
#     權限勾 Send Messages + Embed Links，用產生的網址邀請進伺服器。
# 若同一頻道也設了上面的 webhook，會收到重複訊息，擇一使用即可。
DISCORD_BOT_TOKEN=
