# ── Facebook 租屋社團爬蟲（選填）─────────────────────────────────────────────
# 留空 FACEBOOK_GROUPS 即停用 FB 爬蟲，591 不受影響。
#
# FACEBOOK_GROUPS：逗號分隔的社團 id（純數字）或 vanity slug，例如：
#   FACEBOOK_GROUPS=123456789012345,taipei.rent.house
# 登入狀態：在本機執行 python scripts/fb_login.py 產生 secrets/fb_state.json，
#   再複製到伺服器的 ./secrets/ 目錄（docker 內路徑為 /secrets/fb_state.json）。
# FACEBOOK_MAX_POSTS_PER_GROUP：每個社團每輪最多抓幾篇（預設 30）
# FACEBOOK_INTERVAL_MINUTES：FB 排程間隔分鐘（預設 15，太頻繁容易被封）
# FACEBOOK_ADMIN_CHAT_ID：登入失效時要通知的 Telegram chat id
FACEBOOK_GROUPS=
FACEBOOK_MAX_POSTS_PER_GROUP=30
FACEBOOK_INTERVAL_MINUTES=15
FACEBOOK_ADMIN_CHAT_ID=

